# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/videocall?retryWrites=true&w=majority

# Session Secret (generate random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# ==============================================================================
# WebRTC Configuration (CRITICAL untuk Tri/Indosat/CGNAT)
# ==============================================================================

# STUN Server (optional, can use Google's free STUN)
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server (WAJIB untuk Tri, Indosat, Symmetric NAT)
# Setup: Lihat COTURN_SETUP.md
TURN_SERVER_URL=turn:your-vps-ip:3478
TURN_SERVER_USERNAME=username
TURN_SERVER_CREDENTIAL=password

# TURN Alternate Port (untuk NAT ketat, pakai port 80/443)
TURN_SERVER_URL_ALT=turn:your-vps-ip:80

# TURNS (TLS) - untuk firewall sangat ketat
TURNS_SERVER_URL=turns:your-vps-ip:5349
TURNS_SERVER_USERNAME=username
TURNS_SERVER_CREDENTIAL=password

# Force semua koneksi lewat TURN (untuk testing/debugging Tri)
# WARNING: Ini akan membuat semua traffic lewat TURN, bandwidth intensive!
# FORCE_TURN=true

# ==============================================================================
# Alternative: Public TURN Services (jika tidak setup sendiri)
# ==============================================================================

# Option 1: Metered Video (Free tier 50GB/bulan)
# TURN_SERVER_URL=turn:a.relay.metered.ca:80
# TURN_SERVER_USERNAME=your_metered_username
# TURN_SERVER_CREDENTIAL=your_metered_password

# Option 2: Xirsys (Free tier available)
# TURN_SERVER_URL=turn:your.xirsys.com:80
# TURN_SERVER_USERNAME=your_xirsys_username
# TURN_SERVER_CREDENTIAL=your_xirsys_password

# Option 3: OpenRelay (Free tapi limited)
# TURN_SERVER_URL=turn:openrelay.metered.ca:80
# TURN_SERVER_USERNAME=openrelayproject
# TURN_SERVER_CREDENTIAL=openrelayproject

# ==============================================================================
# MediaMTX - Fitur "Stream" (OBS -> WHIP -> WHEP)
# Setup lengkap: lihat MEDIAMTX_SETUP.md
# ==============================================================================

# Aktifkan fitur stream di halaman room
MEDIAMTX_ENABLED=false

# URL publik MediaMTX (di-proxy Caddy/HTTPS)
MEDIAMTX_PUBLIC_URL=https://media.mikan.my.id

# Control API MediaMTX (localhost saja, jangan di-expose)
MEDIAMTX_API_URL=http://127.0.0.1:9997

# Prefix path per room (roomId => room-<roomId>)
MEDIAMTX_PATH_PREFIX=room-

# Secret untuk token publish/read (buat random string panjang!)
MEDIAMTX_AUTH_SECRET=change-me-mediamtx-auth-secret

# Secret untuk hook runOnAvailable/runOnUnavailable (samakan dengan mediamtx.yml)
MEDIAMTX_HOOK_SECRET=change-me-mediamtx-hook-secret

# Umur token detik (default 2 jam, samakan dengan session)
MEDIAMTX_TOKEN_TTL=7200

