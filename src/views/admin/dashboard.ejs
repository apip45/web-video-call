<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0a">
    <title><%= title %> - Video Call</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <div class="logo-small">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15.6 11.6L22 7v10l-6.4-4.6v-1z"/>
                        <rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>
                    </svg>
                </div>
                <span>Admin Panel</span>
            </div>
            
            <nav class="sidebar-nav">
                <a href="/admin" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Dashboard
                </a>
                <a href="/admin/users" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Kelola User
                </a>
                <a href="/admin/rooms" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15.6 11.6L22 7v10l-6.4-4.6v-1z"/>
                        <rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>
                    </svg>
                    Kelola Room
                </a>
                <a href="/admin/stats" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"/>
                        <line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                    Statistik
                </a>
            </nav>
            
            <div class="sidebar-footer">
                <a href="/" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Kembali
                </a>
                <button class="theme-toggle nav-item" onclick="toggleTheme()">
                    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                    </svg>
                    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                    Theme
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <header class="admin-header">
                <h1>Dashboard</h1>
                <div class="header-actions">
                    <span class="user-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <%= user.displayName || user.username %>
                    </span>
                </div>
            </header>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon stat-icon-users">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Total User</p>
                        <p class="stat-value"><%= stats.userCount %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-rooms">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15.6 11.6L22 7v10l-6.4-4.6v-1z"/>
                            <rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Room Aktif</p>
                        <p class="stat-value"><%= stats.activeRoomCount %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-calls">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07"/>
                            <path d="M5 3h4l2 4-3 2a16 16 0 0 0 7 7l2-3 4 2v4"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Call Hari Ini</p>
                        <p class="stat-value"><%= stats.today.totalCalls || 0 %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-bandwidth">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Bandwidth Hari Ini</p>
                        <p class="stat-value" id="todayBandwidth">
                            <%= ((stats.today.totalBytesSent || 0) + (stats.today.totalBytesReceived || 0)) > 1073741824 
                                ? (((stats.today.totalBytesSent || 0) + (stats.today.totalBytesReceived || 0)) / 1073741824).toFixed(2) + ' GB'
                                : (((stats.today.totalBytesSent || 0) + (stats.today.totalBytesReceived || 0)) / 1048576).toFixed(2) + ' MB' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Online Users & Recent Rooms -->
            <div class="dashboard-grid">
                <!-- Online Users -->
                <div class="card">
                    <div class="card-header">
                        <h3>User Online</h3>
                        <span class="badge badge-success"><%= onlineUsers.length %> online</span>
                    </div>
                    <div class="card-body">
                        <% if (onlineUsers.length > 0) { %>
                            <ul class="user-list">
                                <% onlineUsers.forEach(u => { %>
                                    <li class="user-item">
                                        <span class="user-avatar">
                                            <%= (u.displayName || u.username).charAt(0).toUpperCase() %>
                                        </span>
                                        <div class="user-info">
                                            <span class="user-name"><%= u.displayName || u.username %></span>
                                            <span class="user-role <%= u.role %>"><%= u.role %></span>
                                        </div>
                                        <span class="online-dot"></span>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p class="empty-text">Tidak ada user online</p>
                        <% } %>
                    </div>
                </div>

                <!-- Recent Rooms -->
                <div class="card">
                    <div class="card-header">
                        <h3>Room Terbaru</h3>
                        <a href="/admin/rooms" class="btn btn-ghost btn-sm">Lihat Semua</a>
                    </div>
                    <div class="card-body">
                        <% if (recentRooms.length > 0) { %>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Room ID</th>
                                        <th>Peserta</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentRooms.slice(0, 5).forEach(room => { %>
                                        <tr>
                                            <td>
                                                <a href="/room/<%= room.roomId %>"><%= room.roomId %></a>
                                            </td>
                                            <td><%= room.participants.length %>/2</td>
                                            <td>
                                                <span class="badge <%= room.isActive ? 'badge-success' : 'badge-muted' %>">
                                                    <%= room.isActive ? 'Aktif' : 'Tidak Aktif' %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        <% } else { %>
                            <p class="empty-text">Belum ada room</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Weekly Chart Placeholder -->
            <div class="card">
                <div class="card-header">
                    <h3>Statistik Mingguan</h3>
                </div>
                <div class="card-body">
                    <div class="weekly-stats">
                        <% if (stats.weekly && stats.weekly.length > 0) { %>
                            <div class="bar-chart">
                                <% stats.weekly.forEach(day => { %>
                                    <div class="bar-container">
                                        <div class="bar" style="height: <%= Math.max(10, (day.calls || 0) * 20) %>px;">
                                            <span class="bar-value"><%= day.calls || 0 %></span>
                                        </div>
                                        <span class="bar-label"><%= day._id.split('-')[2] %></span>
                                    </div>
                                <% }); %>
                            </div>
                            <p class="chart-label">Jumlah Call per Hari (7 hari terakhir)</p>
                        <% } else { %>
                            <p class="empty-text">Belum ada data statistik</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Admin Control Toggle -->
            <div class="card admin-control-card">
                <div class="card-header">
                    <div class="admin-control-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 8v4l3 3"/>
                        </svg>
                        <h3>Admin Control</h3>
                    </div>
                    <span id="adminControlBadge" class="badge <%= adminControlEnabled ? 'badge-success' : 'badge-muted' %>">
                        <%= adminControlEnabled ? 'AKTIF' : 'NONAKTIF' %>
                    </span>
                </div>
                <div class="card-body">
                    <div class="admin-control-row">
                        <div class="admin-control-info">
                            <p class="admin-control-desc">
                                Aktifkan atau nonaktifkan semua fungsi kontrol admin di dalam room video call.
                            </p>
                            <p class="admin-control-hint" id="adminControlHint">
                                <% if (adminControlEnabled) { %>
                                    ✅ Admin dapat mengontrol kamera, kualitas video, dan fokus user.
                                <% } else { %>
                                    ⚠️ Admin hanya sebagai peserta biasa — semua kontrol dinonaktifkan.
                                <% } %>
                            </p>
                        </div>
                        <label class="toggle-switch" title="Toggle Admin Control">
                            <input type="checkbox" id="adminControlToggle" <%= adminControlEnabled ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Video Call Settings -->
            <div class="card">
                <div class="card-header">
                    <h3>⚙️ Pengaturan Video Call (Global)</h3>
                    <span class="badge badge-info">Server Optimization</span>
                </div>
                <div class="card-body">
                    <form id="videoSettingsForm" class="settings-form">
                        <div class="settings-grid">
                            <!-- Max Bitrate -->
                            <div class="form-group">
                                <label for="maxBitrate">Max Bitrate (kbps)</label>
                                <select id="maxBitrate" name="maxBitrate" class="form-control">
                                    <option value="300">300 kbps (Low)</option>
                                    <option value="500">500 kbps (Medium-Low)</option>
                                    <option value="800">800 kbps (Medium)</option>
                                    <option value="1000">1000 kbps (Medium-High)</option>
                                    <option value="1500">1500 kbps (High)</option>
                                    <option value="2500">2500 kbps (Very High)</option>
                                    <option value="4000">4000 kbps (Ultra)</option>
                                </select>
                                <small class="form-hint">Bitrate lebih rendah = hemat bandwidth</small>
                            </div>

                            <!-- Resolution -->
                            <div class="form-group">
                                <label for="resolution">Resolusi Video</label>
                                <select id="resolution" name="resolution" class="form-control">
                                    <option value="360p">360p (640x360) - Hemat</option>
                                    <option value="480p">480p (854x480) - Standard</option>
                                    <option value="720p">720p (1280x720) - HD</option>
                                    <option value="1080p">1080p (1920x1080) - Full HD</option>
                                </select>
                                <small class="form-hint">Resolusi lebih rendah = hemat bandwidth & CPU</small>
                            </div>

                            <!-- Frame Rate -->
                            <div class="form-group">
                                <label for="maxFramerate">Max Frame Rate (FPS)</label>
                                <select id="maxFramerate" name="maxFramerate" class="form-control">
                                    <option value="15">15 FPS (Low)</option>
                                    <option value="24">24 FPS (Cinema)</option>
                                    <option value="30">30 FPS (Standard)</option>
                                    <option value="60">60 FPS (Smooth)</option>
                                </select>
                                <small class="form-hint">FPS lebih rendah = hemat bandwidth & CPU</small>
                            </div>

                            <!-- Video Codec -->
                            <div class="form-group">
                                <label for="preferredVideoCodec">Video Codec</label>
                                <select id="preferredVideoCodec" name="preferredVideoCodec" class="form-control">
                                    <option value="auto">Auto (Browser Default)</option>
                                    <option value="h264">H.264 — hemat CPU, cocok mobile low-spec ✅</option>
                                    <option value="vp8">VP8 — kompatibel luas, software encode</option>
                                    <option value="vp9">VP9 — kualitas lebih baik dari VP8, CPU lebih tinggi</option>
                                    <option value="av1">AV1 — efisiensi terbaik, CPU sangat tinggi</option>
                                </select>
                                <small class="form-hint">H.264 direkomendasikan untuk perangkat mobile dengan spesifikasi rendah karena didukung hardware encoder</small>
                            </div>

                            <!-- CPU Overuse Detection -->
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="videoCpuOveruseDetection" name="videoCpuOveruseDetection" checked>
                                    <span>CPU Overuse Detection</span>
                                </label>
                                <small class="form-hint">Otomatis turunkan kualitas jika CPU overload</small>
                            </div>

                            <!-- Audio Echo Cancellation -->
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="audioEchoCancellation" name="audioEchoCancellation" checked>
                                    <span>Echo Cancellation</span>
                                </label>
                                <small class="form-hint">Kurangi echo pada audio</small>
                            </div>

                            <!-- Audio Noise Suppression -->
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="audioNoiseSuppression" name="audioNoiseSuppression" checked>
                                    <span>Noise Suppression</span>
                                </label>
                                <small class="form-hint">Kurangi noise background</small>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="saveSettingsBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                    <polyline points="17 21 17 13 7 13 7 21"/>
                                    <polyline points="7 3 7 8 15 8"/>
                                </svg>
                                Simpan Pengaturan
                            </button>
                            <span id="settingsSaveStatus" class="save-status"></span>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/theme.js"></script>
    <script>
        // Auto refresh stats every 30 seconds
        setInterval(async () => {
            try {
                const response = await fetch('/admin/api/stats/realtime');
                const data = await response.json();
                if (data.success) {
                    // Update display if needed
                    console.log('[Admin] Stats updated:', data.data);
                }
            } catch (error) {
                console.error('[Admin] Failed to fetch stats:', error);
            }
        }, 30000);

        // ====================================================================
        // VIDEO SETTINGS
        // ====================================================================
        
        // Load video settings on page load
        async function loadVideoSettings() {
            try {
                const response = await fetch('/admin/api/settings/video');
                const data = await response.json();
                
                if (data.success) {
                    const settings = data.data;
                    
                    // Set form values
                    document.getElementById('maxBitrate').value = settings.maxBitrate;
                    document.getElementById('resolution').value = settings.resolution;
                    document.getElementById('maxFramerate').value = settings.maxFramerate;
                    document.getElementById('preferredVideoCodec').value = settings.preferredVideoCodec || 'auto';
                    document.getElementById('videoCpuOveruseDetection').checked = settings.videoCpuOveruseDetection;
                    document.getElementById('audioEchoCancellation').checked = settings.audioEchoCancellation;
                    document.getElementById('audioNoiseSuppression').checked = settings.audioNoiseSuppression;
                    
                    console.log('[Admin] Video settings loaded:', settings);
                }
            } catch (error) {
                console.error('[Admin] Failed to load video settings:', error);
            }
        }

        // Save video settings
        document.getElementById('videoSettingsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const saveBtn = document.getElementById('saveSettingsBtn');
            const statusEl = document.getElementById('settingsSaveStatus');
            
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-small"></span> Menyimpan...';
            
            try {
                const settings = {
                    maxBitrate: parseInt(document.getElementById('maxBitrate').value),
                    resolution: document.getElementById('resolution').value,
                    maxFramerate: parseInt(document.getElementById('maxFramerate').value),
                    preferredVideoCodec: document.getElementById('preferredVideoCodec').value,
                    videoCpuOveruseDetection: document.getElementById('videoCpuOveruseDetection').checked,
                    audioEchoCancellation: document.getElementById('audioEchoCancellation').checked,
                    audioNoiseSuppression: document.getElementById('audioNoiseSuppression').checked
                };
                
                const response = await fetch('/admin/api/settings/video', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(settings)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    statusEl.className = 'save-status success';
                    statusEl.textContent = '✓ Tersimpan!';
                    console.log('[Admin] Video settings saved successfully');
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                statusEl.className = 'save-status error';
                statusEl.textContent = '✕ Gagal menyimpan';
                console.error('[Admin] Failed to save video settings:', error);
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                        <polyline points="17 21 17 13 7 13 7 21"/>
                        <polyline points="7 3 7 8 15 8"/>
                    </svg>
                    Simpan Pengaturan
                `;
                
                // Clear status after 3 seconds
                setTimeout(() => {
                    statusEl.textContent = '';
                    statusEl.className = 'save-status';
                }, 3000);
            }
        });

        // Load settings on page load
        loadVideoSettings();

        // ====================================================================
        // ADMIN CONTROL TOGGLE
        // ====================================================================

        const adminControlToggle = document.getElementById('adminControlToggle');
        const adminControlBadge  = document.getElementById('adminControlBadge');
        const adminControlHint   = document.getElementById('adminControlHint');

        adminControlToggle.addEventListener('change', async () => {
            const enabled = adminControlToggle.checked;

            // Optimistic UI update
            adminControlBadge.textContent   = enabled ? 'AKTIF' : 'NONAKTIF';
            adminControlBadge.className     = `badge ${enabled ? 'badge-success' : 'badge-muted'}`;
            adminControlHint.innerHTML      = enabled
                ? '✅ Admin dapat mengontrol kamera, kualitas video, dan fokus user.'
                : '⚠️ Admin hanya sebagai peserta biasa — semua kontrol dinonaktifkan.';

            try {
                const res  = await fetch('/admin/api/settings/admin-control', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled })
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (!data.success) throw new Error(data.message);
                console.log('[Admin] Admin control', enabled ? 'enabled' : 'disabled');
            } catch (err) {
                // Revert on error
                adminControlToggle.checked  = !enabled;
                adminControlBadge.textContent = !enabled ? 'AKTIF' : 'NONAKTIF';
                adminControlBadge.className   = `badge ${!enabled ? 'badge-success' : 'badge-muted'}`;
                adminControlHint.innerHTML    = !enabled
                    ? '✅ Admin dapat mengontrol kamera, kualitas video, dan fokus user.'
                    : '⚠️ Admin hanya sebagai peserta biasa — semua kontrol dinonaktifkan.';
                console.error('[Admin] Failed to toggle admin control:', err.message);
            }
        });
    </script>
</body>
</html>
