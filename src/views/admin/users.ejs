<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0a">
    <title><%= title %> - Video Call</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <div class="logo-small">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15.6 11.6L22 7v10l-6.4-4.6v-1z"/>
                        <rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>
                    </svg>
                </div>
                <span>Admin Panel</span>
            </div>
            
            <nav class="sidebar-nav">
                <a href="/admin" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Dashboard
                </a>
                <a href="/admin/users" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Kelola User
                </a>
                <a href="/admin/rooms" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15.6 11.6L22 7v10l-6.4-4.6v-1z"/>
                        <rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>
                    </svg>
                    Kelola Room
                </a>
                <a href="/admin/stats" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"/>
                        <line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                    Statistik
                </a>
            </nav>
            
            <div class="sidebar-footer">
                <a href="/" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Kembali
                </a>
                <button class="theme-toggle nav-item" onclick="toggleTheme()">
                    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                    </svg>
                    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                    Theme
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <header class="admin-header">
                <h1>Kelola User</h1>
                <div class="header-actions">
                    <button class="btn btn-primary" onclick="openCreateModal()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Tambah User
                    </button>
                </div>
            </header>

            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <!-- Search & Filter -->
            <div class="card">
                <div class="card-body">
                    <form class="filter-form" method="GET" action="/admin/users">
                        <div class="form-group">
                            <input type="text" name="search" class="form-control" placeholder="Cari username atau email..." value="<%= search || '' %>">
                        </div>
                        <div class="form-group">
                            <select name="role" class="form-control">
                                <option value="">Semua Role</option>
                                <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                                <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-secondary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="M21 21l-4.35-4.35"/>
                            </svg>
                            Cari
                        </button>
                    </form>
                </div>
            </div>

            <!-- Users Table -->
            <div class="card">
                <div class="card-header">
                    <h3>Daftar User (<%= pagination.total %>)</h3>
                </div>
                <div class="card-body">
                    <% if (users.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Terdaftar</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(u => { %>
                                        <tr>
                                            <td>
                                                <div class="user-cell">
                                                    <span class="user-avatar">
                                                        <%= (u.displayName || u.username).charAt(0).toUpperCase() %>
                                                    </span>
                                                    <div>
                                                        <span class="user-name"><%= u.displayName || u.username %></span>
                                                        <span class="user-username">@<%= u.username %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= u.email || '-' %></td>
                                            <td>
                                                <span class="badge <%= u.role === 'admin' ? 'badge-primary' : 'badge-muted' %>">
                                                    <%= u.role %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge <%= u.isOnline ? 'badge-success' : 'badge-muted' %>">
                                                    <%= u.isOnline ? 'Online' : 'Offline' %>
                                                </span>
                                            </td>
                                            <td><%= new Date(u.createdAt).toLocaleDateString('id-ID') %></td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="btn btn-ghost btn-sm" onclick="openEditModal('<%= u._id %>', '<%= u.username %>', '<%= u.displayName || '' %>', '<%= u.email || '' %>', '<%= u.role %>')" title="Edit">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>
                                                    <form action="/admin/users/<%= u._id %>/reset-password" method="POST" style="display:inline" onsubmit="return confirm('Reset password user ini?')">
                                                        <button type="submit" class="btn btn-ghost btn-sm" title="Reset Password">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                    <% if (u._id.toString() !== user._id.toString()) { %>
                                                        <form action="/admin/users/<%= u._id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Hapus user ini? Tindakan ini tidak dapat dibatalkan!')">
                                                            <button type="submit" class="btn btn-ghost btn-sm btn-danger" title="Hapus">
                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <polyline points="3 6 5 6 21 6"/>
                                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                                </svg>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (pagination.pages > 1) { %>
                            <div class="pagination">
                                <% if (pagination.page > 1) { %>
                                    <a href="?page=<%= pagination.page - 1 %>&search=<%= search || '' %>&role=<%= role || '' %>" class="btn btn-ghost btn-sm">&laquo; Prev</a>
                                <% } %>
                                
                                <% for (let i = 1; i <= pagination.pages; i++) { %>
                                    <a href="?page=<%= i %>&search=<%= search || '' %>&role=<%= role || '' %>" class="btn btn-ghost btn-sm <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
                                <% } %>
                                
                                <% if (pagination.page < pagination.pages) { %>
                                    <a href="?page=<%= pagination.page + 1 %>&search=<%= search || '' %>&role=<%= role || '' %>" class="btn btn-ghost btn-sm">Next &raquo;</a>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <p class="empty-text">Tidak ada user ditemukan</p>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Edit User</h3>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <form id="userForm" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="userId" id="userId">
                    
                    <div class="form-group">
                        <label for="formUsername">Username</label>
                        <input type="text" id="formUsername" name="username" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="formDisplayName">Nama Tampilan</label>
                        <input type="text" id="formDisplayName" name="displayName" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label for="formEmail">Email</label>
                        <input type="email" id="formEmail" name="email" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label for="formRole">Role</label>
                        <select id="formRole" name="role" class="form-control" required>
                            <option value="user">User</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>

                    <div class="form-group" id="passwordGroup">
                        <label for="formPassword">Password</label>
                        <input type="password" id="formPassword" name="password" class="form-control" minlength="6">
                        <small>Kosongkan jika tidak ingin mengubah password</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeModal()">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/theme.js"></script>
    <script>
        function openEditModal(id, username, displayName, email, role) {
            document.getElementById('modalTitle').textContent = 'Edit User';
            document.getElementById('userId').value = id;
            document.getElementById('formUsername').value = username;
            document.getElementById('formDisplayName').value = displayName;
            document.getElementById('formEmail').value = email;
            document.getElementById('formRole').value = role;
            document.getElementById('passwordGroup').style.display = 'block';
            document.getElementById('formPassword').required = false;
            document.getElementById('userForm').action = '/admin/users/' + id + '/update';
            document.getElementById('editModal').classList.add('open');
        }

        function openCreateModal() {
            document.getElementById('modalTitle').textContent = 'Tambah User';
            document.getElementById('userId').value = '';
            document.getElementById('formUsername').value = '';
            document.getElementById('formDisplayName').value = '';
            document.getElementById('formEmail').value = '';
            document.getElementById('formRole').value = 'user';
            document.getElementById('passwordGroup').style.display = 'block';
            document.getElementById('formPassword').required = true;
            document.getElementById('userForm').action = '/admin/users/create';
            document.getElementById('editModal').classList.add('open');
        }

        function closeModal() {
            document.getElementById('editModal').classList.remove('open');
        }

        // Close modal on outside click
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
</body>
</html>
