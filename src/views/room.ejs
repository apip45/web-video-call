<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/room.css">
</head>
<body class="room-body">
    <!-- Video Container -->
    <div class="video-container" id="videoContainer">
        <!-- Remote Video (Fullscreen) -->
        <div class="remote-video-wrapper" id="remoteVideoWrapper" onclick="handleRemoteVideoClick(event)">
            <video id="remoteVideo" autoplay playsinline></video>
            
            <!-- Remote User Info Overlay -->
            <div class="remote-overlay">
                <div class="remote-user-info">
                    <span id="remoteUsername">Menunggu...</span>
                    <div class="remote-status">
                        <span id="remoteMuteIndicator" class="status-indicator hidden">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="1" y1="1" x2="23" y2="23"/>
                                <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
                                <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                        </span>
                        <span id="remoteCameraIndicator" class="status-indicator hidden">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M16.5 2H7.5C6.67 2 6 2.67 6 3.5v17c0 .83.67 1.5 1.5 1.5h9c.83 0 1.5-.67 1.5-1.5v-17c0-.83-.67-1.5-1.5-1.5z"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        </span>
                        <span id="remoteMirrorIndicator" class="status-indicator mirror-indicator hidden">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="17 1 21 5 17 9"/>
                                <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                                <polyline points="7 23 3 19 7 15"/>
                                <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                            </svg>
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Waiting State -->
            <div class="waiting-state" id="waitingState">
                <div class="waiting-content">
                    <div class="pulse-ring"></div>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <p>Menunggu orang lain bergabung...</p>
                    <p class="room-id-display">Room ID: <strong><%= room.roomId %></strong></p>
                    <button class="btn btn-ghost btn-sm" onclick="copyRoomId()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                        Copy ID
                    </button>
                </div>
            </div>
        </div>

        <!-- Local Video (PIP - Picture in Picture) -->
        <div class="local-video-wrapper" id="localVideoWrapper">
            <video id="localVideo" autoplay playsinline muted></video>
            <div class="local-label">Anda</div>
            <div class="local-status">
                <span id="localMuteIndicator" class="status-indicator hidden">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="1" y1="1" x2="23" y2="23"/>
                        <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
                    </svg>
                </span>
            </div>
        </div>

        <!-- Stats Panel (Admin Only) -->
        <% if (isAdmin && adminControlEnabled) { %>
        <div class="stats-panel" id="statsPanel">
            <div class="stats-panel-header">
                <span>WebRTC Stats</span>
                <button class="btn-close" onclick="toggleStatsPanel()">&times;</button>
            </div>
            <div class="stats-panel-body">
                <div class="stats-row">
                    <span>Resolution:</span>
                    <span id="statResolution">-</span>
                </div>
                <div class="stats-row">
                    <span>Codec:</span>
                    <span id="statCodec">-</span>
                </div>
                <div class="stats-row">
                    <span>Bitrate:</span>
                    <span id="statBitrate">-</span>
                </div>
                <div class="stats-row">
                    <span>Framerate:</span>
                    <span id="statFramerate">-</span>
                </div>
                <div class="stats-row">
                    <span>Latency:</span>
                    <span id="statLatency">-</span>
                </div>
                <div class="stats-row">
                    <span>Jitter:</span>
                    <span id="statJitter">-</span>
                </div>
                <div class="stats-row">
                    <span>Packet Loss:</span>
                    <span id="statPacketLoss">-</span>
                </div>
                <div class="stats-row">
                    <span>Upload:</span>
                    <span id="statBytesSent">-</span>
                </div>
                <div class="stats-row">
                    <span>Download:</span>
                    <span id="statBytesReceived">-</span>
                </div>
            </div>
        </div>

        <!-- Video Quality Settings Panel (Admin Only) -->
        <div class="quality-panel" id="qualityPanel">
            <div class="quality-panel-header">
                <span>🎥 Video Quality Settings</span>
                <button class="btn-close" onclick="toggleQualityPanel()">&times;</button>
            </div>
            <div class="quality-panel-body">
                <!-- Preset Selection -->
                <div class="quality-section">
                    <label class="quality-label">Preset Resolusi</label>
                    <select id="resolutionPreset" class="quality-select" onchange="onPresetChange()">
                        <option value="360p">360p (nHD) - 640x360</option>
                        <option value="480p">480p (SD) - 854x480</option>
                        <option value="720p" selected>720p (HD) - 1280x720</option>
                        <option value="1080p">1080p (Full HD) - 1920x1080</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>

                <!-- Custom Resolution -->
                <div class="quality-section" id="customResolutionSection" style="display: none;">
                    <label class="quality-label">Resolusi Custom</label>
                    <div class="quality-row">
                        <input type="number" id="customWidth" class="quality-input" placeholder="Width" min="320" max="3840" value="1280">
                        <span class="quality-separator">×</span>
                        <input type="number" id="customHeight" class="quality-input" placeholder="Height" min="240" max="2160" value="720">
                    </div>
                </div>

                <!-- Bitrate -->
                <div class="quality-section">
                    <label class="quality-label">
                        Bitrate: <span id="bitrateValue">1200 kbps</span>
                    </label>
                    <input type="range" id="bitrateSlider" class="quality-slider" 
                           min="300" max="5000" step="50" value="1200" 
                           oninput="updateBitrateDisplay()">
                    <div class="quality-range-labels">
                        <span>300 kbps</span>
                        <span>5000 kbps</span>
                    </div>
                </div>

                <!-- Framerate -->
                <div class="quality-section">
                    <label class="quality-label">
                        Framerate: <span id="framerateValue">30 fps</span>
                    </label>
                    <input type="range" id="framerateSlider" class="quality-slider" 
                           min="15" max="60" step="5" value="30" 
                           oninput="updateFramerateDisplay()">
                    <div class="quality-range-labels">
                        <span>15 fps</span>
                        <span>60 fps</span>
                    </div>
                </div>

                <!-- Apply Button -->
                <button class="btn btn-primary btn-block" onclick="applyQualitySettings()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Terapkan Perubahan
                </button>

                <div class="quality-info">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    <p>Pengaturan akan diterapkan ke video user secara realtime tanpa notifikasi. Jika resolusi tidak support, sistem otomatis menurunkan ke resolusi yang lebih rendah.</p>
                </div>
            </div>
        </div>

        <!-- Focus Control Panel (Admin Only) -->
        <div class="focus-panel" id="focusPanel">
            <div class="focus-panel-header">
                <span>🎯 Focus Control</span>
                <button class="btn-close" onclick="toggleFocusPanel()">&times;</button>
            </div>
            <div class="focus-panel-body">
                <!-- Not supported yet / waiting -->
                <div id="focusUnsupported" class="focus-unsupported">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <p>Client tidak support manual focus. Klik Refresh untuk cek ulang, atau gunakan mode Auto (default).</p>
                </div>

                <!-- Controls (shown when supported) -->
                <div id="focusControls" style="display:none">
                    <!-- Focus Mode -->
                    <div class="quality-section">
                        <label class="quality-label">Focus Mode</label>
                        <div class="focus-mode-toggle">
                            <button id="focusModeAuto" class="focus-mode-btn active" onclick="setAdminFocusMode('auto')">Auto</button>
                            <button id="focusModeManual" class="focus-mode-btn" onclick="setAdminFocusMode('manual')">Manual</button>
                        </div>
                    </div>

                    <!-- Focus Distance Slider -->
                    <div class="quality-section">
                        <label class="quality-label">
                            Focus Distance: <span id="focusDistanceValue">0.50</span>
                        </label>
                        <input type="range" id="focusDistanceSlider" class="quality-slider"
                               min="0" max="1" step="0.01" value="0.5"
                               oninput="onFocusDistanceChange()"
                               onchange="applyFocusDistance()">
                        <div class="quality-range-labels">
                            <span>Near (close)</span>
                            <span>Far (infinite)</span>
                        </div>
                    </div>

                    <!-- Point of Interest -->
                    <div class="quality-section">
                        <label class="quality-label">Point of Interest (Tap-to-Focus)</label>
                        <button id="poiToggle" class="focus-poi-btn" onclick="toggleAdminPOI()" style="display:none">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <circle cx="12" cy="12" r="3"/>
                                <line x1="12" y1="2" x2="12" y2="5"/>
                                <line x1="12" y1="19" x2="12" y2="22"/>
                                <line x1="2" y1="12" x2="5" y2="12"/>
                                <line x1="19" y1="12" x2="22" y2="12"/>
                            </svg>
                            <span id="poiBtnText">POI: OFF</span>
                        </button>
                        <p id="poiHint" class="focus-poi-hint" style="display:none">
                            Klik di area video lawan bicara untuk mengatur titik fokus kamera.
                        </p>
                    </div>
                </div>

                <!-- Refresh button (always visible) -->
                <button class="btn btn-ghost focus-refresh-btn" onclick="requestFocusCapabilities()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"/>
                        <path d="M3.51 15a9 9 0 1 0 .49-3.64"/>
                    </svg>
                    Refresh Kapabilitas
                </button>
            </div>
        </div>

        <!-- Audio Reset Panel (Admin Only) -->
        <div class="audio-panel" id="audioPanel">
            <div class="audio-panel-header">
                <span>🔊 Audio Reset</span>
                <button class="btn-close" onclick="toggleAudioPanel()">&times;</button>
            </div>
            <div class="audio-panel-body">
                <!-- Shown when user is connected -->
                <div class="audio-reset-user-section" id="audioResetUserSection" style="display:none">
                    <div class="audio-reset-status" id="audioResetStatus">Siap</div>

                    <!-- Opsi 1: Soft restart -->
                    <div class="audio-option-group">
                        <span class="audio-option-label">Opsi 1 — Soft Restart</span>
                        <p class="audio-option-desc">Coba terlebih dahulu. Memaksa Chrome kembali ke mode komunikasi tanpa memutus sesi.</p>
                        <button class="audio-reset-btn" id="audioResetBtn" onclick="adminResetAudio()">
                            <svg class="reset-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <path d="M3.51 15a9 9 0 1 0 .49-3.64"/>
                            </svg>
                            <span id="audioResetBtnText">Restart Audio</span>
                        </button>
                    </div>

                    <div class="audio-panel-divider"></div>

                    <!-- Opsi 2: Force rejoin -->
                    <div class="audio-option-group">
                        <span class="audio-option-label">Opsi 2 — Force Rejoin</span>
                        <p class="audio-option-desc">Jika Opsi 1 gagal. Reload halaman user secara paksa — user akan reconnect ulang dan audio pasti kembali normal.</p>
                        <button class="audio-rejoin-btn" id="audioRejoinBtn" onclick="adminForceRejoin()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="flex-shrink:0">
                                <path d="M21 2v6h-6"/>
                                <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                                <path d="M3 22v-6h6"/>
                                <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
                            </svg>
                            <span id="audioRejoinBtnText">Force Rejoin User</span>
                        </button>
                    </div>
                </div>
                <!-- Shown when no user connected -->
                <div class="audio-no-user" id="audioResetNoUser">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Belum ada user yang terhubung
                </div>
            </div>
        </div>
        <% } %>

        <!-- Stream Panel (MediaMTX / OBS) -->
        <% if (mediaMtxEnabled) { %>
        <div class="stream-panel" id="streamPanel">
            <div class="stream-panel-header">
                <span>📡 Stream via OBS</span>
                <button class="btn-close" onclick="toggleStreamPanel()">&times;</button>
            </div>
            <div class="stream-panel-body">
                <!-- Status -->
                <div class="stream-status" id="streamStatus">
                    <span class="stream-status-dot" id="streamStatusDot"></span>
                    <span id="streamStatusText">Belum aktif</span>
                </div>

                <!-- Actions -->
                <div class="stream-actions">
                    <button class="stream-session-btn" id="streamSessionBtn" onclick="toggleStreamSession()">
                        Aktifkan Sesi Stream
                    </button>
                    <button class="stream-watch-btn" id="streamWatchBtn" onclick="toggleStreamWatch()" disabled>
                        Tonton Stream
                    </button>
                </div>

                <!-- Setup OBS -->
                <div id="streamSetup">
                    <div class="quality-section">
                        <label class="quality-label">WHIP Server (OBS → Settings → Stream)</label>
                        <div class="stream-copy-row">
                            <input type="text" class="quality-input stream-input" id="streamWhipUrl" readonly>
                            <button class="stream-copy-btn" onclick="copyStreamField('streamWhipUrl', 'URL WHIP disalin')">Copy</button>
                        </div>
                    </div>
                    <div class="quality-section">
                        <label class="quality-label">Bearer Token</label>
                        <div class="stream-copy-row">
                            <input type="password" class="quality-input stream-input" id="streamToken" readonly>
                            <button class="stream-copy-btn" onclick="copyStreamField('streamToken', 'Token disalin')">Copy</button>
                        </div>
                    </div>
                    <div class="stream-hint">
                        <p>1. OBS → Settings → Stream → Service: <strong>WHIP</strong></p>
                        <p>2. Tempel Server URL &amp; Bearer Token di atas</p>
                        <p>3. Encoder H264 (tanpa B-frame), audio Opus 48kHz</p>
                        <p>4. Klik <strong>Start Streaming</strong> di OBS</p>
                    </div>
                </div>

                <div class="stream-note">
                    Saat stream aktif, mikrofon web diambil alih oleh OBS agar audio tidak dobel.
                </div>
            </div>
        </div>
        <% } %>

        <!-- Mini Stats (All Users) -->
        <div class="mini-stats" id="miniStats">
            <span id="miniPacketLoss">-</span>
            <span id="miniLatency">-</span>
        </div>
    </div>

    <!-- Controls Bar -->
    <div class="controls-bar" id="controlsBar">
        <div class="controls-left">
            <a href="/" class="btn btn-ghost btn-icon" title="Kembali">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
            </a>
        </div>
        
        <div class="controls-center">
            <!-- Mic Toggle -->
            <div class="btn-wrapper">
                <button class="control-btn" id="micBtn" onclick="toggleMic()" title="Mute/Unmute Mic">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="1" y1="1" x2="23" y2="23"/>
                        <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
                        <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Mic</span>
            </div>

            <!-- Camera Toggle -->
            <div class="btn-wrapper">
                <button class="control-btn" id="cameraBtn" onclick="toggleCamera()" title="Camera On/Off">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 7l-7 5 7 5V7z"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16.5 2H7.5C6.67 2 6 2.67 6 3.5v17c0 .83.67 1.5 1.5 1.5h9c.83 0 1.5-.67 1.5-1.5v-17c0-.83-.67-1.5-1.5-1.5z"/>
                        <line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Kamera</span>
            </div>

            <% if (!isAdmin && adminControlEnabled) { %>
            <!-- Mirror Preview (User Only, Visual) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="mirrorBtn" onclick="toggleMirrorPreview()" title="Cermin Kamera">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-8-10-8a18.45 18.45 0 0 1 5.06-5.94"/>
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19"/>
                        <line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Cermin</span>
            </div>
            <% } %>

            <!-- Switch Camera (Mobile) -->
            <div class="btn-wrapper mobile-only">
                <button class="control-btn" id="switchCameraBtn" onclick="switchCamera()" title="Switch Camera">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                        <path d="M17 8l-2 2m0-2l2 2"/>
                    </svg>
                </button>
                <span class="btn-label">Ganti</span>
            </div>

            <!-- Screen Share -->
            <div class="btn-wrapper">
                <button class="control-btn" id="screenShareBtn" onclick="toggleScreenShare()" title="Share Screen">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                        <line x1="8" y1="21" x2="16" y2="21"/>
                        <line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                        <line x1="8" y1="21" x2="16" y2="21"/>
                        <line x1="12" y1="17" x2="12" y2="21"/>
                        <line x1="4" y1="4" x2="20" y2="16"/>
                    </svg>
                </button>
                <span class="btn-label">Layar</span>
            </div>

            <% if (mediaMtxEnabled) { %>
            <!-- Stream via OBS (MediaMTX) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="streamBtn" onclick="toggleStreamPanel()" title="Stream via OBS">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 16.1A5 5 0 0 1 5.9 20"/>
                        <path d="M2 12.05A9 9 0 0 1 9.95 20"/>
                        <path d="M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"/>
                        <line x1="2" y1="20" x2="2.01" y2="20"/>
                    </svg>
                </button>
                <span class="btn-label">Stream</span>
            </div>
            <% } %>

            <!-- Hide PIP (Desktop Only) -->
            <div class="btn-wrapper desktop-only">
                <button class="control-btn" id="hidePipBtn" onclick="toggleHidePip()" title="Hide/Show Preview">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                        <line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Sembunyi</span>
            </div>

            <!-- Enlarge PIP (Desktop Only) -->
            <div class="btn-wrapper desktop-only">
                <button class="control-btn" id="enlargePipBtn" onclick="togglePipEnlarge()" title="Perbesar/Kecilkan Preview">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        <line x1="11" y1="8" x2="11" y2="14"/>
                        <line x1="8" y1="11" x2="14" y2="11"/>
                    </svg>
                </button>
                <span class="btn-label">Perbesar</span>
            </div>

            <!-- End Call -->
            <div class="btn-wrapper">
                <button class="control-btn control-btn-danger" id="endCallBtn" onclick="endCall()" title="End Call">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/>
                        <line x1="23" y1="1" x2="1" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Tutup</span>
            </div>
        </div>
        
        <div class="controls-right">
            <% if (isAdmin && adminControlEnabled) { %>
            <!-- Hide Buttons (Admin) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="hideButtonsBtn" onclick="toggleHideButtons()" title="Hide/Show Buttons">
                    <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                        <line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                </button>
                <span class="btn-label">Sembunyi</span>
            </div>

            <!-- Toggle Stats Panel (Admin) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="statsBtn" onclick="toggleStatsPanel()" title="WebRTC Stats">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"/>
                        <line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                </button>
                <span class="btn-label">Stats</span>
            </div>

            <!-- Toggle User Camera (Admin) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="userCameraBtn" onclick="toggleUserCamera()" title="Nonaktifkan kamera user">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 7l-7 5 7 5V7z"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                </button>
                <span class="btn-label">Kamera User</span>
            </div>

            <!-- Switch User Camera (Admin) -->
            <div class="btn-wrapper">
                <button class="control-btn" id="switchUserCameraBtn" onclick="switchUserCamera()" title="Switch kamera user">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                        <path d="M17 8l-2 2m0-2l2 2"/>
                    </svg>
                </button>
                <span class="btn-label">Ganti Kamera</span>
            </div>


            <!-- Compact Admin Tools (contains: Focus, Ring, Audio Reset, Blank Remote, Quality) -->
            <div class="admin-quick-wrapper" id="adminQuickWrapper">
                <button class="control-btn" id="adminQuickBtn" onclick="toggleAdminQuickMenu()" title="Admin Tools">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="5" cy="12" r="1.8"/>
                        <circle cx="12" cy="12" r="1.8"/>
                        <circle cx="19" cy="12" r="1.8"/>
                    </svg>
                </button>

                <div class="admin-quick-menu" id="adminQuickMenu">
                    <button class="admin-quick-action control-btn" id="focusBtn" onclick="toggleFocusPanel()" title="Focus Control">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <circle cx="12" cy="12" r="3"/>
                            <line x1="12" y1="2" x2="12" y2="5"/>
                            <line x1="12" y1="19" x2="12" y2="22"/>
                            <line x1="2" y1="12" x2="5" y2="12"/>
                            <line x1="19" y1="12" x2="22" y2="12"/>
                        </svg>
                        <span>Focus Control</span>
                    </button>

                    <button class="admin-quick-action control-btn" id="ringUserBtn" onclick="toggleUserRing()" title="Panggil user (5 detik)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M10.73 21a2 2 0 0 0 2.54 0"/>
                        </svg>
                        <span>Panggil User</span>
                    </button>

                    <button class="admin-quick-action control-btn" id="audioBtn" onclick="toggleAudioPanel()" title="Reset Audio User">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                        </svg>
                        <span>Reset Audio</span>
                    </button>

                    <button class="admin-quick-action control-btn" id="blankRemoteBtn" onclick="toggleBlankRemote()" title="Blank Remote Video">
                        <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                        <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                            <line x1="2" y1="2" x2="22" y2="22"/>
                        </svg>
                        <span>Blank Remote Video</span>
                    </button>

                    <button class="admin-quick-action control-btn" id="qualityBtn" onclick="toggleQualityPanel()" title="Video Quality Settings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 1v6m0 6v6m9-9h-6m-6 0H3"/>
                        </svg>
                        <span>Video Quality</span>
                    </button>
                </div>
            </div>

            <% } %>
            
            <!-- Fullscreen -->
            <div class="btn-wrapper">
                <button class="control-btn" id="fullscreenBtn" onclick="toggleFullscreen()" title="Fullscreen">
                    <svg class="icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 3 21 3 21 9"/>
                        <polyline points="9 21 3 21 3 15"/>
                        <line x1="21" y1="3" x2="14" y2="10"/>
                        <line x1="3" y1="21" x2="10" y2="14"/>
                    </svg>
                    <svg class="icon-shrink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="4 14 10 14 10 20"/>
                        <polyline points="20 10 14 10 14 4"/>
                        <line x1="14" y1="10" x2="21" y2="3"/>
                        <line x1="3" y1="21" x2="10" y2="14"/>
                    </svg>
                </button>
                <span class="btn-label">Fullscreen</span>
            </div>
        </div>
    </div>

    <!-- Connection Status -->
    <div class="connection-status" id="connectionStatus">
        <div class="status-content">
            <div class="spinner"></div>
            <span id="statusText">Menghubungkan...</span>
        </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Hidden data for JS -->
    <script>
        // Data dari server
        const ROOM_DATA = {
            roomId: '<%= room.roomId %>',
            userId: '<%= userId %>',
            username: '<%= username %>',
            userRole: '<%= userRole || "user" %>',
            isAdmin: <%= isAdmin ? 'true' : 'false' %>,
            adminControlEnabled: <%= adminControlEnabled ? 'true' : 'false' %>,
            iceServers: <%- iceServers %>,
            videoSettings: <%- videoSettings %>,
            webrtcMode: '<%= webrtcMode %>',  // 'mesh' or 'sfu'
            ionSFUConfig: <%- ionSFUConfig %>,
            mediaMtx: <%- mediaMtxConfig %>
        };
        
        console.log('[Room] 🎯 WebRTC Mode:', ROOM_DATA.webrtcMode);
        if (ROOM_DATA.webrtcMode === 'sfu') {
            console.log('[Room] 🌐 Ion-SFU Server:', ROOM_DATA.ionSFUConfig.serverUrl);
        }
    </script>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/videoQualityPresets.js"></script>
    <!-- Load Ion-SFU client if in SFU mode -->
    <% if (webrtcMode === 'sfu') { %>
    <script src="/js/ionSFUClient.js"></script>
    <% } %>
    <script src="/js/whepClient.js"></script>
    <script src="/js/webrtc.js"></script>
    <script src="/js/room.js"></script>
</body>
</html>
